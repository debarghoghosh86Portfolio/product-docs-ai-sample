# Copy this file to ".env" and fill in your values.
# NEVER commit your real .env file to Git (it's already in .gitignore).

# ---------------------------------------------------------------
# 1) Which LLM writes the answers / docs?
#    mock      -> fake offline model, free, great for learning & tests
#    anthropic -> Claude (needs ANTHROPIC_API_KEY)
#    openai    -> GPT (needs OPENAI_API_KEY)
#    ollama    -> free local model (install https://ollama.com first)
# ---------------------------------------------------------------
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------
# 2) Which model turns text into vectors (embeddings) for search?
#    hashing -> offline, free, keyword-style (default)
#    openai  -> semantic, needs OPENAI_API_KEY
#    ollama  -> semantic, free local (run: ollama pull nomic-embed-text)
# Claude has no embeddings API, so with Claude use hashing or ollama.
# ---------------------------------------------------------------
EMBEDDING_PROVIDER=hashing
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------
# 3) RAG tuning knobs
# ---------------------------------------------------------------
CHUNK_SIZE=800        # characters per chunk
CHUNK_OVERLAP=150     # characters shared between neighbouring chunks
TOP_K=4               # how many chunks to give the LLM per question
INDEX_PATH=output/index.json
